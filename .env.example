# Copy to .env (never commit .env) or set these in your host's dashboard.
NODE_ENV=production
PORT=3000
# PostgreSQL connection string. Use a managed database with automated backups.
DATABASE_URL=postgres://user:password@host:5432/dlcf
# Set to true when the database requires TLS (most managed providers do).
DATABASE_SSL=true
# Secure cookies need HTTPS. Leave unset in production (defaults to true).
# COOKIE_SECURE=true
# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer), so client IPs are logged correctly.
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Run database migrations automatically when the server starts.
MIGRATE_ON_START=true
