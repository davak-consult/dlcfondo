# Copy to .env (never commit .env) or set these in your host's dashboard.
NODE_ENV=production
PORT=3000
# MySQL/MariaDB connection. Either set the separate DB_* values (easiest on Hostinger)...
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_dlcf
DB_USER=u000000000_dlcf
DB_PASSWORD=change-me
# ...or one connection string (URL-encode special characters in the password):
# DATABASE_URL=mysql://user:password@host:3306/dlcf
# Set to true when a remote database requires TLS. Not needed for localhost.
DATABASE_SSL=false
# Secure cookies need HTTPS. Leave unset in production (defaults to true).
# COOKIE_SECURE=true
# Number of reverse proxies in front of the app (e.g. 1 behind a load balancer), so client IPs are logged correctly.
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Run database migrations automatically when the server starts.
MIGRATE_ON_START=true
